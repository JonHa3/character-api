<!DOCTYPE html>
<html>
<head>
  <title>Character Gallery</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <nav>
        <a href="index.html">Home</a>
        <a href="details.html">Details</a>
        <a href="about.html">About</a>
        <a href="new-character-form.html">Add a Character</a>
    </nav>
    <h1>Character Gallery</h1>
    <p>A collection of iconic cartoon characters from across different animated universes.</p>
    <input type="text" placeholder="Search by name or category">
    <a href="details.html">
        <div class="card">
            <img src="/images/gumball-details.png" alt="Gumball Waterson">
            <h2>Gumball Waterson</h2>
            <ul>
                <li>Universe: Amazing World of Gumball</li>
                <li>Role: Main Character</li>
                <li>Power: Toon Force</li>
            </ul>
            <p class="card-desc">A mischievous blue cat who gets into wacky adventures with his fish brother Darwin.</p>
        </div>
    </a>
    <a href="details.html">
        <div class="card">
            <img src="/images/ben-tennyson.webp" alt="Benjamin Tennyson">
            <h2>Benjamin Tennyson</h2>
            <ul>
                <li>Universe: Ben 10</li>
                <li>Role: Main Character</li>
                <li>Power: Omnitrix</li>
            </ul>
            <p class="card-desc">A young hero who uses the Omnitrix to transform into powerful aliens and fight evil.</p>
        </div>
    </a>
    <a href="details.html">
        <div class="card">
            <img src="/images/aang.png" alt="Aang">
            <h2>Aang</h2>
            <ul>
                <li>Universe: Avatar</li>
                <li>Role: Avatar</li>
                <li>Power: Four elements</li>
            </ul>
            <p class="card-desc">The last airbender and reincarnation of the Avatar, tasked with restoring balance to the world.</p>
        </div>
    </a>
    <a href="details.html">
        <div class="card">
            <img src="/images/dipper.png" alt="Dipper Pines">
            <h2>Dipper Pines</h2>
            <ul>
                <li>Universe: Gravity Falls</li>
                <li>Role: Deuteragonist</li>
                <li>Power: Mystery Journal</li>
            </ul>
            <p class="card-desc">A curious and adventurous kid who spends his summer uncovering the paranormal secrets of Gravity Falls.</p>
        </div>
    </a>
    <a href="details.html">
        <div class="card">
            <img src="/images/finn.png" alt="Finn the Human">
            <h2>Finn the Human</h2>
            <ul>
                <li>Universe: Adventure Time</li>
                <li>Role: Hero</li>
                <li>Power: Magic Sword</li>
            </ul>
            <p class="card-desc">The last known human in the Land of Ooo, always ready for the next heroic adventure.</p>
        </div>
    </a>

    <footer>
        <p>&copy; 2026 Character Gallery. Created for a CSC-340 assignment.</p>
    </footer>
</body>
</html>